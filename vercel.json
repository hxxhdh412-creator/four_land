{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "fourland.vn" }], "destination": "https://www.fourland.vn/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/api/admin/v1/:path*", "destination": "/api/cms" },
    { "source": "/api/admin-login", "destination": "/api/cms" },
    { "source": "/api/admin-archive", "destination": "/api/cms" },
    { "source": "/api/admin-property", "destination": "/api/cms" },
    { "source": "/api/admin-image", "destination": "/api/cms" },
    { "source": "/bat-dong-san/:slug", "destination": "/api/seo-property?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=120" }]
    }
  ]
}
